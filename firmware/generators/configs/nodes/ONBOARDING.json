{
    "node_name": "ONBOARDING",
    "busses": {
        "CCAN": {
            "peripheral": "FDCAN2",
            "tx": [
                {
                    "message_name": "heartbeat_onboarding",
                    "description": "Heartbeat sent by onboarding code",
                    "signals": [
                        {
                            "signal_name": "blink_count",
                            "description": "Amount of blinks",
                            "data_type": "uint16_t",
                            "length": 16
                        },
                        {
                            "signal_name": "pranesh_favorite_number",
                            "description": "My favorite number",
                            "data_type": "uint16_t",
                            "length": 4
                        }
                    ],
                    "period_ms": 200,
                    "id_override": "0x7C0",
                    "priority": 3
                }
            ],
            "rx": [
                {
                    "message_name": "response_onboarding"
                }
            ]
        }
    },
    "fault_library_enabled": false
}
