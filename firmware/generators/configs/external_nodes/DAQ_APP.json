{
    "node_name": "DAQ_APP",
    "bus_name": "CCAN",
    "tx": [
        {
            "message_name": "charge_request",
            "description": "Message from DAQ App to A_BOX to request charging",
            "signals": [
                {
                    "signal_name": "charge_voltage",
                    "description": "Requested charge voltage in decivolts",
                    "data_type": "uint16_t",
                    "unit": "V",
                    "scale": 0.1
                },
                {
                    "signal_name": "charge_current",
                    "description": "Requested charge current in deciamps",
                    "data_type": "uint16_t",
                    "unit": "A",
                    "scale": 0.1
                },
                {
                    "signal_name": "charge_enable",
                    "description": "Request to start charging",
                    "data_type": "bool"
                },
                {
                    "signal_name": "balance_enable",
                    "description": "Request to start balancing",
                    "data_type": "bool"
                }
            ],
            "period_ms": 500,
            "priority": 3
        },
        {
            "message_name": "response_onboarding",
            "description": "DaqApp response message sent by onboarding code",
            "signals": [
                {
                    "signal_name": "on_amount",
                    "description": "Amount of time turned on",
                    "data_type": "uint16_t"
                }
            ],
            "period_ms": 200,
            "priority": 3
        }
    ],
    "rx": [
        {
            "message_name": "elcon_status"
        },
        {
            "message_name": "charging_telemetry"
        },
        {
            "message_name": "heartbeat_onboarding"
        }
    ]
}
